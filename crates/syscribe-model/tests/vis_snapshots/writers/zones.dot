  s_sec_zn_zc_002_arch_gw -> s_sec_zn_zc_001_arch_fc [color="#b3261e", arrowhead=none, style=dashed, penwidth=3, label="CD-ZC-001 · SL 2/3 weak · MAVLink", ltail="cluster_s_sec_zn_zc_002", lhead="cluster_s_sec_zn_zc_001"];
  s_sec_zn_zc_003_arch_tel -> s_sec_zn_zc_002_arch_gw [color="#7a3ea5", arrowhead=none, label="CD-ZC-002 · SL 2/2", ltail="cluster_s_sec_zn_zc_003", lhead="cluster_s_sec_zn_zc_002"];
