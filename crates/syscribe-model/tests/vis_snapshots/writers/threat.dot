digraph "TARA" {
  rankdir=LR;
  nodesep=0.4;
  ranksep=0.55;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  s_sec_tara_ts_tg_001 [label="TS-TG-001\nSpoof a command\nrisk medium\nfeasibility high", shape=box, style="filled", fillcolor="#fff4d6", color="#b7791f", tooltip="Sec::TARA::TS-TG-001"];
  s_sec_tara_ds_tg_001 [label="DS-TG-001\nHijack\nimpact negligible", shape=box, style="filled", fillcolor="#f1f2f4", color="#8a8f98", tooltip="Sec::TARA::DS-TG-001"];
  s_sec_asset_tg_001 [label="ASSET-TG-001\nCommand link\napproved\nintegrity", shape=box, style="filled", fillcolor="#f1f2f4", color="#8a8f98", tooltip="Sec::ASSET-TG-001"];
  s_sec_tara_csg_tg_001 [label="CSG-TG-001\nAuthenticate commands\nCAL2\nintegrity", shape=box, style="filled", fillcolor="#e3f5e8", color="#1e8a3c", tooltip="Sec::TARA::CSG-TG-001"];
  s_sec_tara_sc_tg_001 [label="SC-TG-001\nSign commands\nprevention\napproved", shape=box, style="filled", fillcolor="#e3f5e8", color="#1e8a3c", tooltip="Sec::TARA::SC-TG-001"];
  s_sec_tara_ts_tg_002 [label="TS-TG-002\nJam the link\nrisk high\nfeasibility low", shape=box, style="filled", fillcolor="#fdecea", color="#b3261e", tooltip="Sec::TARA::TS-TG-002"];
  s_sec_tara_ds_tg_002 [label="DS-TG-002\nNoise\nimpact severe", shape=box, style="filled", fillcolor="#fdecea", color="#b3261e", tooltip="Sec::TARA::DS-TG-002"];
  s_sec_tara_csg_tg_002 [label="CSG-TG-002\nKeep the link up\nCAL2\navailability\n[W802 no control]", shape=box, style="filled", fillcolor="#fdecea", color="#b3261e", tooltip="Sec::TARA::CSG-TG-002"];
  s_sec_tara_ts_tg_003 [label="TS-TG-003\nUntreated\nrisk high\nfeasibility low\n[no goal]", shape=box, style="filled", fillcolor="#fdecea", color="#b3261e", tooltip="Sec::TARA::TS-TG-003"];
  s_sec_tara_ts_tg_001 -> s_sec_tara_ds_tg_001 [color="#555555", arrowhead=normal];
  s_sec_tara_ds_tg_001 -> s_sec_asset_tg_001 [color="#555555", arrowhead=normal];
  s_sec_asset_tg_001 -> s_sec_tara_csg_tg_001 [color="#555555", arrowhead=vee, style=dashed, label="protectedBy"];
  s_sec_tara_csg_tg_001 -> s_sec_tara_sc_tg_001 [color="#555555", arrowhead=vee, style=dashed, label="implementedBy"];
  s_sec_tara_ts_tg_002 -> s_sec_tara_ds_tg_002 [color="#555555", arrowhead=normal];
  s_sec_tara_ds_tg_002 -> s_sec_tara_csg_tg_002 [color="#555555", arrowhead=vee, style=dashed, label="protectedBy"];
  s_sec_tara_ts_tg_003 -> s_sec_tara_ds_tg_002 [color="#555555", arrowhead=normal];
}
