digraph "FtD" {
  rankdir=TB;
  nodesep=0.4;
  ranksep=0.55;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  s_safety_ft_a [label="FTE-DS-001\nChannel A fails\ndual-point\nλ 1.0e-4/h · P 9.5e-2\n[1 MCS]", shape=circle, style="filled", fillcolor="#fff4d6", color="#b7791f", penwidth=3, tooltip="Safety::FT::A"];
  s_safety_ft_b [label="FTE-DS-002\nChannel B fails\ndual-point\nP 1.0e-2\n[1 MCS]", shape=diamond, style="filled", fillcolor="#fff4d6", color="#b7791f", penwidth=3, tooltip="Safety::FT::B"];
  s_safety_ft_both [label="AND\nFTG-DS-002\nBoth channels fail", shape=house, style="filled", fillcolor="#eef3f8", color="#1f497d", tooltip="Safety::FT::Both"];
  s_safety_ft_c [label="FTE-DS-003\nComparator fails\nsingle point of failure\nP 1.0e-6\n[1 MCS]", shape=circle, style="filled", fillcolor="#fdecea", color="#b3261e", penwidth=3, tooltip="Safety::FT::C"];
  s_safety_ft_top [label="OR\nFTG-DS-001\nHarm occurs\ntop event\nP 9.5e-4\n[2 MCS] [1 single point]", shape=invhouse, style="filled", fillcolor="#fff4d6", color="#b7791f", penwidth=3, tooltip="Safety::FT::Top"];
  s_safety_ft_both -> s_safety_ft_a [color="#555555", arrowhead=none, arrowtail=normal, dir=both];
  s_safety_ft_both -> s_safety_ft_b [color="#555555", arrowhead=none, arrowtail=normal, dir=both];
  s_safety_ft_top -> s_safety_ft_both [color="#555555", arrowhead=none, arrowtail=normal, dir=both];
  s_safety_ft_top -> s_safety_ft_c [color="#555555", arrowhead=none, arrowtail=normal, dir=both];
}
