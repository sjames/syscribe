digraph "FtD" {
  rankdir=TB;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  s_safety_ft_a [label="Channel A fails\ndual-point\nλ 1.0e-4/h · P 9.5e-2\n[1 MCS]", shape=ellipse, style="filled", fillcolor="#fff4d6", color="#b7791f", penwidth=3, tooltip="Safety::FT::A"];
  s_safety_ft_b [label="Channel B fails\ndual-point\nP 1.0e-2\n[1 MCS]", shape=diamond, style="filled", fillcolor="#fff4d6", color="#b7791f", penwidth=3, tooltip="Safety::FT::B"];
  s_safety_ft_both [label="AND\nBoth channels fail", shape=house, style="filled", fillcolor="#eef3f8", color="#1f497d", tooltip="Safety::FT::Both"];
  s_safety_ft_c [label="Comparator fails\nsingle point of failure\nP 1.0e-6\n[1 MCS]", shape=ellipse, style="filled", fillcolor="#fdecea", color="#b3261e", penwidth=3, tooltip="Safety::FT::C"];
  s_safety_ft_top [label="OR\nHarm occurs\ntop event\nP 9.5e-4\n[2 MCS] [1 single point]", shape=invhouse, style="filled", fillcolor="#fff4d6", color="#b7791f", penwidth=3, tooltip="Safety::FT::Top"];
  s_safety_ft_both -> s_safety_ft_a [color="#555", arrowhead=none];
  s_safety_ft_both -> s_safety_ft_b [color="#555", arrowhead=none];
  s_safety_ft_top -> s_safety_ft_both [color="#555", arrowhead=none];
  s_safety_ft_top -> s_safety_ft_c [color="#555", arrowhead=none];
}
