{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syscribe.dev/schemas/matrix.schema.json",
  "title": "syscribe matrix --json",
  "description": "Stable `--json` contract (GH #413). A new optional property is a compatible change; removing or retyping one, or changing its meaning, bumps `schemaVersion`.",
  "type": "object",
  "required": [
    "columns",
    "coverage",
    "rows",
    "schemaVersion"
  ],
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "cells": {
            "type": "object"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "overall"
      ],
      "properties": {
        "overall": {
          "type": "object",
          "required": [
            "applicable",
            "covered"
          ],
          "properties": {
            "applicable": {
              "type": "integer"
            },
            "covered": {
              "type": "integer"
            },
            "pct": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "perConfig": {
          "type": "object"
        }
      }
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "gaps": {
      "type": "array",
      "description": "Every cell that needs work (state gap, planned, failing or open) with what to do and the ids needed to do it (GH #424). In the flat view (no feature model) configuration is null.",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "requirementFile",
          "configuration",
          "state",
          "action",
          "tests"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "requirementFile": {
            "type": "string"
          },
          "configuration": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "gap",
              "planned",
              "failing",
              "open"
            ]
          },
          "action": {
            "enum": [
              "create-test",
              "activate-test",
              "fix-failing-test",
              "decide-binding",
              "widen-test"
            ]
          },
          "tests": {
            "type": "array",
            "description": "Tests already linked to the requirement, whatever their status.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "file"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "file": {
                  "type": "string"
                }
              }
            }
          },
          "suggestedTestId": {
            "type": "string",
            "description": "The next free test id in the requirement's area; present for create-test."
          }
        }
      }
    }
  }
}
