{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syscribe.dev/schemas/feature-check.schema.json",
  "title": "syscribe feature-check [--deep] --json",
  "description": "Stable `--json` contract (GH #413). A new optional property is a compatible change; removing or retyping one, or changing its meaning, bumps `schemaVersion`.",
  "type": "object",
  "required": [
    "findings",
    "schemaVersion"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "void": {
      "type": "boolean"
    },
    "coreFeatures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deadFeatures": {
      "type": "array"
    },
    "falseOptionalFeatures": {
      "type": "array"
    },
    "invalidConfigurations": {
      "type": "array"
    },
    "diagnoses": {
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0"
    }
  }
}
