{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syscribe.dev/schemas/features.schema.json",
  "title": "syscribe features --json",
  "description": "Stable `--json` contract (GH #413). A new optional property is a compatible change; removing or retyping one, or changing its meaning, bumps `schemaVersion`.",
  "type": "object",
  "required": [
    "features",
    "schemaVersion"
  ],
  "properties": {
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "qualifiedName",
          "groupKind",
          "mandatory",
          "requires",
          "excludes",
          "parameters",
          "selectedIn",
          "totalConfigurations"
        ],
        "properties": {
          "qualifiedName": {
            "type": "string"
          },
          "groupKind": {
            "type": "string"
          },
          "mandatory": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null when the feature leaves it unset"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selectedIn": {
            "type": "integer"
          },
          "totalConfigurations": {
            "type": "integer"
          }
        }
      }
    },
    "schemaVersion": {
      "const": "1.0"
    }
  }
}
